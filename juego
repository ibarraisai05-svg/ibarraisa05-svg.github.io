// ❤️ Juego de corazones para Michelin ❤️

var canvas = document.querySelector('canvas');
var ctx = canvas.getContext('2d');

var player;
var hearts = [];
var score = 0;
var phase = 'idle';

var gameTimer = null;
var heartTimer = null;

var keys = {
  left: false,
  right: false
};

// ─────────────────────────────────────
// BOTÓN PLAY
// ─────────────────────────────────────

var playButton = document.createElement('button');

playButton.textContent = '▶ PLAY ❤️';

playButton.style.display = 'block';
playButton.style.margin = '15px auto';
playButton.style.padding = '12px 30px';
playButton.style.border = 'none';
playButton.style.borderRadius = '25px';
playButton.style.background = '#ff4d6d';
playButton.style.color = 'white';
playButton.style.fontSize = '20px';
playButton.style.fontWeight = 'bold';
playButton.style.cursor = 'pointer';

canvas.parentNode.insertBefore(playButton, canvas);

playButton.addEventListener('click', start);

// ─────────────────────────────────────
// INICIAR
// ─────────────────────────────────────

function start() {

  if (gameTimer) clearInterval(gameTimer);
  if (heartTimer) clearInterval(heartTimer);

  hearts = [];
  score = 0;
  phase = 'running';

  player = {
    x: canvas.width / 2 - 40,
    y: canvas.height - 65,
    width: 80,
    height: 30,
    speed: 7
  };

  playButton.textContent = '❤️ JUGANDO...';
  playButton.style.background = '#d6336c';

  // Los corazones aparecen cada 1.2 segundos
  heartTimer = setInterval(function () {
    createHeart();
  }, 1200);

  // Juego
  gameTimer = setInterval(function () {
    update();
    draw();
  }, 1000 / 60);

  draw();
}

// ─────────────────────────────────────
// CREAR CORAZÓN
// ─────────────────────────────────────

function createHeart() {

  if (phase !== 'running') return;

  hearts.push({
    x: Math.random() * (canvas.width - 30) + 15,
    y: -25,
    size: 25,
    
    // Más lento para que dure más
    speed: 1.5 + Math.random() * 1.2
  });
}

// ─────────────────────────────────────
// ACTUALIZAR
// ─────────────────────────────────────

function update() {

  if (phase !== 'running') return;

  // Movimiento
  if (keys.left) {
    player.x -= player.speed;
  }

  if (keys.right) {
    player.x += player.speed;
  }

  // Límites
  if (player.x < 0) {
    player.x = 0;
  }

  if (player.x + player.width > canvas.width) {
    player.x = canvas.width - player.width;
  }

  // Corazones
  for (var i = hearts.length - 1; i >= 0; i--) {

    var heart = hearts[i];

    heart.y += heart.speed;

    // Atrapar corazón
    if (
      heart.y + heart.size > player.y &&
      heart.y - heart.size < player.y + player.height &&
      heart.x + heart.size > player.x &&
      heart.x - heart.size < player.x + player.width
    ) {

      score++;

      hearts.splice(i, 1);

      // 10 corazones
      if (score >= 10) {
        finishGame();
        return;
      }

    } else if (heart.y > canvas.height + 40) {

      hearts.splice(i, 1);
    }
  }
}

// ─────────────────────────────────────
// TERMINAR JUEGO
// ─────────────────────────────────────

function finishGame() {

  phase = 'finished';

  clearInterval(gameTimer);
  clearInterval(heartTimer);

  gameTimer = null;
  heartTimer = null;

  hearts = [];

  playButton.textContent = '↻ JUGAR OTRA VEZ';
  playButton.style.background = '#ff4d6d';

  draw();
}

// ─────────────────────────────────────
// DIBUJAR TODO
// ─────────────────────────────────────

function draw() {

  ctx.clearRect(
    0,
    0,
    canvas.width,
    canvas.height
  );

  // Fondo
  var gradient = ctx.createLinearGradient(
    0,
    0,
    0,
    canvas.height
  );

  gradient.addColorStop(0, '#fff5f7');
  gradient.addColorStop(1, '#ffe0e8');

  ctx.fillStyle = gradient;

  ctx.fillRect(
    0,
    0,
    canvas.width,
    canvas.height
  );

  // Pantalla inicial
  if (phase === 'idle') {

    drawStartScreen();

    return;
  }

  // Pantalla final
  if (phase === 'finished') {

    drawFinalMessage();

    return;
  }

  // Título
  ctx.textAlign = 'center';

  ctx.font = 'bold 22px Arial';
  ctx.fillStyle = '#d6336c';

  ctx.fillText(
    'Atrapa los corazones',
    canvas.width / 2,
    32
  );

  // Contador
  ctx.font = 'bold 20px Arial';
  ctx.fillStyle = '#8e2450';

  ctx.fillText(
    score + ' / 10 ❤️',
    canvas.width / 2,
    62
  );

  // Corazones
  hearts.forEach(function (heart) {

    drawHeart(
      heart.x,
      heart.y,
      heart.size
    );

  });

  // Jugador
  drawPlayer();
}

// ─────────────────────────────────────
// PANTALLA INICIAL
// ─────────────────────────────────────

function drawStartScreen() {

  ctx.textAlign = 'center';

  ctx.fillStyle = '#d6336c';

  ctx.font = 'bold 30px Arial';

  ctx.fillText(
    '❤️ Un pequeño juego ❤️',
    canvas.width / 2,
    canvas.height / 2 - 45
  );

  ctx.fillStyle = '#8e2450';

  ctx.font = '18px Arial';

  ctx.fillText(
    'Atrapa 10 corazones',
    canvas.width / 2,
    canvas.height / 2
  );

  ctx.fillText(
    'Muévete de izquierda a derecha',
    canvas.width / 2,
    canvas.height / 2 + 32
  );

  ctx.font = '24px Arial';

  ctx.fillText(
    '❤️ ❤️ ❤️',
    canvas.width / 2,
    canvas.height / 2 + 75
  );
}

// ─────────────────────────────────────
// CORAZÓN
// ─────────────────────────────────────

function drawHeart(x, y, size) {

  ctx.save();

  ctx.fillStyle = '#ff4d6d';

  ctx.beginPath();

  ctx.moveTo(x, y + size * 0.8);

  ctx.bezierCurveTo(
    x - size * 1.2,
    y,
    x - size * 0.7,
    y - size,
    x,
    y - size * 0.3
  );

  ctx.bezierCurveTo(
    x + size * 0.7,
    y - size,
    x + size * 1.2,
    y,
    x,
    y + size * 0.8
  );

  ctx.fill();

  ctx.restore();
}

// ─────────────────────────────────────
// JUGADOR
// ─────────────────────────────────────

function drawPlayer() {

  ctx.fillStyle = '#d6336c';

  ctx.beginPath();

  ctx.roundRect(
    player.x,
    player.y,
    player.width,
    player.height,
    12
  );

  ctx.fill();

  ctx.fillStyle = 'white';

  ctx.font = '20px Arial';

  ctx.textAlign = 'center';

  ctx.fillText(
    '♥',
    player.x + player.width / 2,
    player.y + 23
  );
}

// ─────────────────────────────────────
// MENSAJE FINAL ❤️
// ─────────────────────────────────────

function drawFinalMessage() {

  ctx.textAlign = 'center';

  // Corazones decorativos
  drawHeart(45, 80, 22);
  drawHeart(canvas.width - 45, 80, 22);

  drawHeart(50, canvas.height - 60, 20);
  drawHeart(canvas.width - 50, canvas.height - 60, 20);

  ctx.fillStyle = '#d6336c';

  ctx.font = 'bold 32px Arial';

  ctx.fillText(
    '¡Lo lograste! ❤️',
    canvas.width / 2,
    canvas.height / 2 - 100
  );

  ctx.font = 'bold 21px Arial';

  ctx.fillStyle = '#8e2450';

  ctx.fillText(
    'Atrapaste los 10 corazones',
    canvas.width / 2,
    canvas.height / 2 - 55
  );

  ctx.font = '20px Arial';

  ctx.fillText(
    'Pero hay uno que no necesitaste atrapar...',
    canvas.width / 2,
    canvas.height / 2
  );

  ctx.font = 'bold 23px Arial';

  ctx.fillStyle = '#d6336c';

  ctx.fillText(
    'porque ya tienes el mío ❤️',
    canvas.width / 2,
    canvas.height / 2 + 42
  );

  ctx.font = 'bold 26px Arial';

  ctx.fillText(
    'Te quiero, Michelin ❤️',
    canvas.width / 2,
    canvas.height / 2 + 95
  );
}

// ─────────────────────────────────────
// TECLADO
// ─────────────────────────────────────

document.addEventListener('keydown', function (e) {

  if (e.key === 'ArrowLeft' || e.key === 'a') {
    keys.left = true;
  }

  if (e.key === 'ArrowRight' || e.key === 'd') {
    keys.right = true;
  }

});

document.addEventListener('keyup', function (e) {

  if (e.key === 'ArrowLeft' || e.key === 'a') {
    keys.left = false;
  }

  if (e.key === 'ArrowRight' || e.key === 'd') {
    keys.right = false;
  }

});

// ─────────────────────────────────────
// CONTROL CON EL DEDO
// ─────────────────────────────────────

var touchStartX = 0;

canvas.addEventListener(
  'touchstart',
  function (e) {

    touchStartX = e.touches[0].clientX;

  },
  { passive: true }
);

canvas.addEventListener(
  'touchmove',
  function (e) {

    var touchX = e.touches[0].clientX;
    var difference = touchX - touchStartX;

    if (difference < -10) {
      keys.left = true;
      keys.right = false;
    }

    if (difference > 10) {
      keys.right = true;
      keys.left = false;
    }

  },
  { passive: true }
);

canvas.addEventListener(
  'touchend',
  function () {

    keys.left = false;
    keys.right = false;

  }
);

// ─────────────────────────────────────
// REDIMENSIONAR
// ─────────────────────────────────────

function resize() {

  var size = Math.min(
    window.innerWidth,
    window.innerHeight
  );

  canvas.width = Math.min(size, 500);
  canvas.height = Math.min(size * 1.25, 650);

  if (player) {
    player.y = canvas.height - 65;
  }

  draw();
}

window.addEventListener('resize', resize);

// ─────────────────────────────────────
// INICIO
// ─────────────────────────────────────

resize();
draw();